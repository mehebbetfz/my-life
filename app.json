{
  "expo": {
    "name": "My Life",
    "slug": "my-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mylife",
    "owner": "mehebbet55",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a05816b9-5ff9-46b1-9eac-21eaaf02eb63",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mylife.planner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.mylife.planner",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a05816b9-5ff9-46b1-9eac-21eaaf02eb63"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-document-picker",
      "expo-file-system",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EA4B71",
          "sounds": [
            "./assets/sounds/classic.wav",
            "./assets/sounds/soft.wav",
            "./assets/sounds/bright.wav",
            "./assets/sounds/pulse.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-updates",
      "expo-font",
      "expo-asset"
    ]
  }
}
